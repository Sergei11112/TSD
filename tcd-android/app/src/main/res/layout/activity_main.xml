<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical">

    <WebView android:id="@+id/webview"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1"/>

    <LinearLayout android:id="@+id/settings_panel"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:padding="24dp"
        android:background="#f0f0f0" android:visibility="gone">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/settings_title" android:textSize="22sp"
            android:textColor="#2c3e50" android:textStyle="bold" android:layout_marginBottom="16dp"/>

        <EditText android:id="@+id/url_input"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="@string/server_url_hint" android:inputType="textUri"
            android:textSize="20sp" android:padding="14dp" android:background="#ffffff"/>

        <Button android:id="@+id/btn_save"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/open" android:textSize="20sp"
            android:backgroundTint="#3498db" android:textColor="#ffffff"
            android:layout_marginTop="16dp" android:padding="14dp"/>
    </LinearLayout>

    <TextView android:id="@+id/status_text"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="#2c3e50" android:textColor="#aecfe8" android:textSize="12sp"
        android:padding="6dp" android:text="WMS ТСД"/>
</LinearLayout>
