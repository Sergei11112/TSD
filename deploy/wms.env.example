# /etc/wms/wms.env — скопировать в /etc/wms/wms.env и заполнить.
# Права: chown wms:wms, chmod 600

# PostgreSQL (боевой вариант). Пароль должен совпадать с созданным для роли wms.
WMS_DATABASE_URL=postgresql+psycopg2://wms:СЛОЖНЫЙ_ПАРОЛЬ@127.0.0.1:5432/wms

# Секретный ключ для подписи сессий — сгенерировать:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
WMS_SECRET_KEY=заменить-на-сгенерированный-hex-64

# Сеть
WMS_HOST=0.0.0.0
WMS_PORT=8000
